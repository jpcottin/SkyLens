<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The observer's position places the horizon; coarse is enough for the sky, fine helps satellites. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Camera passthrough behind the overlay. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Orbital elements are refreshed from Celestrak; everything else is computed on the device. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The app degrades to a drawn, hand-panned sky without any of these. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Projected activity rendered on Display AI Glasses with Jetpack Compose Glimmer.
             xr_projected tells the system to run it with a projected context so that its
             sensors are the glasses' own and its UI goes to the lens. -->
        <activity
            android:name=".ui.glasses.GlassesActivity"
            android:exported="true"
            android:requiredDisplayCategory="xr_projected"
            android:theme="@style/Theme.SkyLens.Glasses">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
    </application>

</manifest>
